<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow connecting to private LAN / self-hosted HTTP KodBox instances as well as HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
